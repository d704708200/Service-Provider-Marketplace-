# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/service_marketplace?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRE=30d

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_optional

# CORS Allowed Client URLs (comma-separated if multiple)
ADMIN_PANEL_URL=https://serviceprovider3.netlify.app,http://localhost:5173
CUSTOMER_APP_URL=http://localhost:8083
PROVIDER_APP_URL=http://localhost:8081

# Seed Accounts (Development & Testing)
ADMIN_SEED_EMAIL=admin@service-marketplace.com
ADMIN_SEED_PASSWORD=your_secure_admin_password
ADMIN_SEED_NAME=Platform Administrator
ADMIN_SEED_PHONE=+91 9876500000
ADMIN_SEED_DEPARTMENT=Operations

PROVIDER_SEED_EMAIL=provider@example.com
PROVIDER_SEED_PASSWORD=your_secure_provider_password
PROVIDER_SEED_NAME=Demo Service Provider
PROVIDER_SEED_PHONE=+91 9876500001
PROVIDER_SEED_VERIFIED=true
