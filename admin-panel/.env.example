# Admin Panel Environment Variables
# Local Development API Base URL:
VITE_API_URL=http://localhost:5000/api

# For Production (e.g. Netlify / Vercel):
# Set VITE_API_URL in your hosting platform's build environment variables
# to the live deployed Express backend URL, ending with /api:
# VITE_API_URL=https://your-backend-api.onrender.com/api
