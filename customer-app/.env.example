# Production / Verified Cloud Backend:
# EXPO_PUBLIC_API_URL=https://<verified-render-backend-host>/api

# Local Development over Wi-Fi / LAN (PC IPv4):
EXPO_PUBLIC_API_URL=http://192.168.1.2:5000/api

# Secure Development Tunnel:
# EXPO_PUBLIC_API_URL=https://<your-tunnel-subdomain>.trycloudflare.com/api

# Android Emulator (if running emulator on same PC):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
